# Template de variáveis de ambiente.
# Copie para `.env` (que NÃO é versionado) e preencha com os valores reais.
#
#   cp .env.example .env
#
# O Django lê essas variáveis do ambiente do serviço.
# Em desenvolvimento, nada é obrigatório — o projeto roda com os padrões.

# --- Django / segurança -----------------------------------------------------
# O SECRET_KEY NUNCA é escrito no código. Gere o segredo encriptado com:
#   ./segredos.py gerar
# e depois grave o valor aqui com:
#   DJANGO_MASTER_KEY="sua frase" ./segredos.py decriptar --escrever-env
#
# DJANGO_SECRET_KEY=   <- production: o servico define a variavel no ambiente.
DJANGO_SECRET_KEY=
# Frase-semente que decripta o arquivo local `secrets/secret.key` (dev).
# So e necessaria em desenvolvimento; em producao o valor vem pronto.
DJANGO_MASTER_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=
# DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Impressora -------------------------------------------------------------
IMPRESSORA_NOME=impresora_padrão
IMPRESSORA_IP=10.1.168.164
