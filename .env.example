# Template de variáveis de ambiente.
# Copie para `.env` (que NÃO é versionado) e preencha com os valores reais.
#
#   cp .env.example .env
#
# O Django lê essas variáveis do ambiente do serviço.
# Em desenvolvimento, nada é obrigatório — o projeto roda com os padrões.

# --- Django / segurança -----------------------------------------------------
# Gere um segredo real:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=
# DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Impressora -------------------------------------------------------------
IMPRESSORA_NOME=impresora_padrão
IMPRESSORA_IP=10.1.168.164
